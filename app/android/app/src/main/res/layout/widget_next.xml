<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/n_ring"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/n_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/w_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/n_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/w_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/n_edit"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/w_btn_soft"
        android:contentDescription="@string/widget_type"
        android:padding="9dp"
        android:src="@drawable/ic_w_edit_l" />

    <ImageView
        android:id="@+id/n_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/w_btn"
        android:contentDescription="@string/widget_next_action"
        android:padding="8dp"
        android:src="@drawable/ic_w_play" />
</LinearLayout>
