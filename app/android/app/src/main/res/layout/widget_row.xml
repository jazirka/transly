<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/r_mode"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/w_chip"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/w_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/r_pos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:paddingEnd="6dp"
            android:singleLine="true"
            android:textColor="@color/w_sub"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/r_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/w_btn_soft"
            android:contentDescription="@string/widget_prev"
            android:padding="3dp"
            android:src="@drawable/ic_w_prev" />

        <ImageView
            android:id="@+id/r_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/w_btn_soft"
            android:contentDescription="@string/widget_nextrow"
            android:padding="3dp"
            android:src="@drawable/ic_w_next" />
    </LinearLayout>

    <TextView
        android:id="@+id/r_src"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="@color/w_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/r_tr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/w_sub"
        android:textSize="12sp"
        android:textStyle="italic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/r_edit"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/w_pill_soft"
            android:contentDescription="@string/widget_type"
            android:padding="8dp"
            android:src="@drawable/ic_w_edit_l" />

        <ImageView
            android:id="@+id/r_send"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.4"
            android:background="@drawable/w_pill"
            android:contentDescription="@string/widget_send"
            android:padding="8dp"
            android:src="@drawable/ic_w_send" />
    </LinearLayout>
</LinearLayout>
