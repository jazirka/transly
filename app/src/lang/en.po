msgid "Додає"
msgstr "Adds"

msgctxt "core"
msgid "рушії: {n}"
msgstr "engines: {n}"

msgctxt "core"
msgid "формати: {n}"
msgstr "formats: {n}"

msgctxt "core"
msgid "мови: {n}"
msgstr "languages: {n}"

